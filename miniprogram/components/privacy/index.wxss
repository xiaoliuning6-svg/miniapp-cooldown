.mask {
  position: fixed; left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(17, 24, 39, .55); z-index: 9999;
  display: flex; align-items: center; justify-content: center; padding: 48rpx;
}
.panel {
  width: 100%; max-width: 640rpx; background: #fff; border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
}
.title { font-size: 36rpx; font-weight: 600; text-align: center; margin-bottom: 28rpx; }
.body { font-size: 26rpx; color: #4e5969; line-height: 1.75; }
.para { margin-bottom: 20rpx; }
.item { display: flex; margin-bottom: 16rpx; }
.dot {
  flex: none; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #e8f0ff; color: #2f6fed; font-size: 22rpx;
  text-align: center; line-height: 36rpx; margin-right: 16rpx; margin-top: 4rpx;
}
.warn { color: #e5484d; margin-top: 8rpx; margin-bottom: 8rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 28rpx; }
.btn {
  flex: 1; height: 84rpx; line-height: 84rpx; text-align: center;
  border-radius: 12rpx; font-size: 28rpx; background: #2f6fed; color: #fff; border: none;
}
.btn::after { border: none; }
.btn-ghost { background: #fff; color: #2f6fed; border: 1rpx solid #2f6fed; }
