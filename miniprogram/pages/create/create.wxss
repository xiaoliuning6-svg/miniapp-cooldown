.create-page { padding-bottom: 0; }

.intro { padding: 16rpx 8rpx 32rpx; }
.intro-title { display: block; font-size: 40rpx; font-weight: 600; color: var(--text); }
.intro-sub { display: block; margin-top: 12rpx; font-size: 26rpx; color: var(--text-2); }

.form-card { padding: 12rpx 28rpx; }
.field { padding: 28rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.field:last-child { border-bottom: none; }

.label { display: block; font-size: 28rpx; font-weight: 500; margin-bottom: 18rpx; }
.required { color: var(--danger); }
.optional { color: var(--text-2); font-size: 22rpx; font-weight: 400; margin-left: 8rpx; }

.input, .textarea {
  width: 100%; font-size: 30rpx; color: var(--text);
  background: #f7f8fa; border-radius: 12rpx; padding: 20rpx 24rpx;
}
.textarea { min-height: 140rpx; line-height: 1.6; }

.price-wrap { display: flex; align-items: center; background: #f7f8fa; border-radius: 12rpx; padding-left: 24rpx; }
.yuan { font-size: 32rpx; color: var(--text-2); }
.price-input { background: transparent; padding-left: 8rpx; }

.picker-value {
  display: flex; align-items: center; justify-content: space-between;
  background: #f7f8fa; border-radius: 12rpx; padding: 20rpx 24rpx; font-size: 30rpx;
}
.arrow { color: var(--text-2); font-size: 40rpx; line-height: 1; }

.hint { display: block; margin-top: 14rpx; font-size: 22rpx; color: var(--text-2); }

.submit-btn { margin-top: 32rpx; }
.notice { margin-top: 28rpx; padding: 0 12rpx; }
.notice-text { font-size: 22rpx; color: var(--text-2); line-height: 1.7; }
