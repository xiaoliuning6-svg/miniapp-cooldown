<view class="page">
  <privacy />
  <view class="hero">
    <text class="hero-title">买之前，先冷静一下</text>
    <text class="hero-sub">把想买的东西交给陌生人评评理</text>
  </view>

  <!-- 骨架屏 -->
  <view wx:if="{{loading && list.length === 0}}" class="skeleton">
    <view wx:for="{{[1,2,3]}}" wx:key="*this" class="sk-card"></view>
  </view>

  <!-- 列表 -->
  <block wx:else>
    <decision-card
      wx:for="{{list}}" wx:key="id" item="{{item}}"
      bind:tap="onCardTap" />
    <view wx:if="{{list.length === 0 && !loading}}" class="empty">
      <text class="empty-text">还没有待审批的决定</text>
      <button class="btn btn-ghost empty-btn" bindtap="onGoCreate">发起第一个审批</button>
    </view>
    <view class="load-tip">
      <text wx:if="{{loading}}">加载中…</text>
      <text wx:elif="{{!hasMore && list.length > 0}}">没有更多了</text>
    </view>
  </block>
  <view class="tabbar-bottom"></view>
</view>
