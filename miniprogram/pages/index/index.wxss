.hero { background: linear-gradient(135deg, #2f6fed, #5b8def); border-radius: 20rpx; padding: 40rpx 32rpx; margin-bottom: 24rpx; }
.hero-title { display: block; color: #fff; font-size: 36rpx; font-weight: 500; margin-bottom: 12rpx; }
.hero-sub { display: block; color: rgba(255,255,255,.85); font-size: 26rpx; }
.skeleton .sk-card { height: 200rpx; background: #eef0f3; border-radius: 16rpx; margin-bottom: 20rpx; animation: pulse 1.2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: .5; } }
.empty { text-align: center; padding: 120rpx 0; }
.empty-text { display: block; color: #86909c; font-size: 28rpx; margin-bottom: 32rpx; }
.empty-btn { width: 280rpx; margin: 0 auto; }
.load-tip { text-align: center; color: #c9cdd4; font-size: 24rpx; padding: 24rpx 0; }
