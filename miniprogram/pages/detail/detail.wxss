.detail-page { padding-bottom: 64rpx; }
.loading-box { padding: 120rpx 0; text-align: center; color: var(--text-2); }

.main-card { padding: 36rpx 28rpx; }
.product-name { font-size: 38rpx; font-weight: 600; flex: 1; margin-right: 16rpx; }
.price { font-size: 42rpx; font-weight: 700; color: var(--danger); }
.meta { margin-top: 20rpx; display: flex; align-items: center; gap: 16rpx; }

.tag { font-size: 22rpx; padding: 6rpx 14rpx; border-radius: 100rpx; background: #f2f3f5; color: var(--text-2); }
.tag-cooling { background: #e8f0ff; color: var(--primary); }
.tag-abandoned { background: #e6f7ee; color: var(--success); }
.tag-purchased { background: #fff0e8; color: var(--warning); }
.tag-passed, .tag-rejected { background: #f2f3f5; color: var(--text-2); }

.countdown-box { margin-top: 28rpx; padding: 24rpx; background: #f7f9ff; border-radius: 12rpx; text-align: center; }
.countdown-label { display: block; font-size: 24rpx; color: var(--text-2); margin-bottom: 12rpx; }
.expired-box { background: #f6f7f9; }
.expired-box .countdown-label { margin-bottom: 0; color: var(--text); }

.section-title { font-size: 28rpx; font-weight: 600; margin-bottom: 20rpx; }
.sub-title { margin-top: 28rpx; }
.content-text { display: block; font-size: 28rpx; line-height: 1.7; color: #3d424c; }

.tally-line { font-size: 26rpx; margin-bottom: 16rpx; }
.approve-text { color: var(--success); }
.reject-text { color: var(--danger); }
.bar { display: flex; height: 16rpx; border-radius: 100rpx; overflow: hidden; background: #f0f1f3; }
.bar-approve { background: var(--success); transition: width .3s; }
.bar-reject { background: var(--danger); transition: width .3s; }
.tally-tip { display: block; margin-top: 16rpx; }

.vote-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f1f3; }
.vote-item:last-child { border-bottom: none; }
.vote-choice { font-size: 26rpx; font-weight: 500; }
.vote-reason { display: block; margin-top: 12rpx; font-size: 27rpx; line-height: 1.6; color: #3d424c; }

.vote-card { padding-bottom: 36rpx; }
.tip-card { background: #f4f5f7; border-radius: var(--radius); padding: 24rpx 28rpx; margin-bottom: 24rpx; }
.tip-card text { font-size: 25rpx; line-height: 1.6; color: var(--text-2); }
.success-tip { background: #e6f7ee; }
.success-tip text { color: var(--success); }

.settle-row { display: flex; gap: 20rpx; }
.settle-btn { flex: 1; }
.buy-btn { background: var(--danger); }

.subscribe-btn, .share-btn { margin-top: 8rpx; }
.report-btn { margin-top: 20rpx; height: 72rpx; font-size: 26rpx; color: var(--text-2); border-color: var(--line); }
