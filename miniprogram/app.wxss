/* app.wxss 全局样式 */
page {
  --primary: #2f6fed;
  --danger: #e5484d;
  --success: #1a9d5a;
  --warning: #f5a623;
  --text: #1d2129;
  --text-2: #86909c;
  --bg: #f5f6f8;
  --card: #ffffff;
  --radius: 16rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--text);
  background: var(--bg);
  box-sizing: border-box;
}

view, text, input, textarea, button { box-sizing: border-box; }

.page { min-height: 100vh; padding: 24rpx; }

.card {
  background: var(--card);
  border-radius: var(--radius);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }

.muted { color: var(--text-2); font-size: 24rpx; }
.ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.btn {
  display: flex; align-items: center; justify-content: center;
  height: 88rpx; border-radius: 12rpx; font-size: 30rpx;
  background: var(--primary); color: #fff; border: none;
}
.btn::after { border: none; }
.btn:disabled { opacity: .5; }
.btn-ghost { background: #fff; color: var(--primary); border: 1rpx solid var(--primary); }

/* 安全区（非 tabBar 页，如详情页用）：只留系统安全区 */
.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }

/* tabBar 页面专用底部留白：原生 tabBar 约 100rpx，留 120rpx + 安全区，
   保证列表最后一项 / 提交按钮滚到底时不被 tabBar 遮挡。
   开发者工具与安卓机 env(safe-area-inset-bottom) 常为 0，所以 120rpx 是硬性下限。 */
.tabbar-bottom {
  height: calc(120rpx + constant(safe-area-inset-bottom));
  height: calc(120rpx + env(safe-area-inset-bottom));
}
